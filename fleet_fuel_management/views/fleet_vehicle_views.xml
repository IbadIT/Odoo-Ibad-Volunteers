<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_fuel" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.fuel</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_fuel_logs" type="object" class="oe_stat_button" icon="fa-tint"
                        help="Show the fuel logs of this vehicle">
                    <field name="fuel_log_count" widget="statinfo" string="Fuel"/>
                </button>
            </div>
            <xpath expr="//field[@name='odometer']/.." position="after">
                <field name="avg_consumption" invisible="vehicle_type == 'generator'"/>
            </xpath>
            <!-- Generators have an engine too: show fleet's Engine group (fuel type, power, CO2). -->
            <xpath expr="//field[@name='fuel_type']/.." position="attributes">
                <attribute name="invisible">vehicle_type not in ('car', 'generator')</attribute>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_model_view_form_fuel" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.form.inherit.fuel</field>
        <field name="model">fleet.vehicle.model</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>
        <field name="arch" type="xml">
            <!-- Same for generator models, so their default fuel type can be set (fleet defaults to Electric). -->
            <xpath expr="//field[@name='default_fuel_type']/../.." position="attributes">
                <attribute name="invisible">vehicle_type not in ('car', 'generator')</attribute>
            </xpath>
            <field name="transmission" position="attributes">
                <attribute name="invisible">vehicle_type == 'generator'</attribute>
            </field>
        </field>
    </record>

    <record id="action_fleet_generators" model="ir.actions.act_window">
        <field name="name">Generators</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('vehicle_type', '=', 'generator')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a first generator</p>
            <p>Create a model with type Generator under Configuration, then a vehicle that uses it.</p>
        </field>
    </record>
</odoo>
